{
  "name": "stationeers-phase-sort-webview",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "check:web": "tsc --noEmit",
    "capture:web": "node web_src/scripts/capture-webview.mjs",
    "capture:target": "node web_src/scripts/capture-webview.mjs --url http://127.0.0.1:8765/?snapshot=1 --width 1448 --height 1086 --output .tmp-smoke/webui-current.png",
    "capture:eight": "node web_src/scripts/capture-webview.mjs --url http://127.0.0.1:8765/?scenario=eight-components --width 1448 --height 1086 --output .tmp-smoke/webui-eight-components.png --virtual-time-budget 6000",
    "smoke:functional": "node web_src/scripts/functional-smoke.mjs",
    "smoke:web": "node web_src/scripts/visual-smoke.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.1",
    "vite": "^7.2.7",
    "typescript": "^5.9.3",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "playwright": "^1.57.0"
  },
  "devDependencies": {}
}
